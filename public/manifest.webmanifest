{
  "id": "/",
  "name": "Território Digital",
  "short_name": "Território",
  "description": "Administração e interessados salvos no aparelho do publicador",
  "lang": "pt-BR",
  "start_url": "/login",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#44783c",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/publicador/receber",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "files", "accept": ["application/json", "application/octet-stream", ".json", ".tdpub"] }] }
  },
  "file_handlers": [{
    "action": "/publicador",
    "accept": { "application/json": [".json", ".tdpub"] },
    "launch_type": "single-client"
  }]
}
